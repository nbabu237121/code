# Export private key
keytool -importkeystore -srckeystore client.jks -destkeystore client.pkcs12 -srcstoretype JKS -deststoretype PKCS12 -deststorepass keystorepass
openssl pkcs12 -in client.pkcs12 -nocerts -nodes -out client.key -passin pass:keystorepass

# Export cert
keytool -exportcert -alias client -keystore client.jks -file client.crt -storepass keystorepass

# CA cert (if separate)
keytool -exportcert -alias cacert -keystore truststore.jks -file ca.crt -storepass trustpass

