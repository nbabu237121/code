#!/bin/bash
SR_URL="https://schema-registry:8081"
USER="username"
PASS="password"

# Basic auth + client cert (PEM files)
curl -u "$USER:$PASS" \
  --cert client.crt \
  --key client.key \
  --cacert ca.crt \
  -k  # Skip verify if self-signed
  "$SR_URL/subjects"

# List schemas
curl -u "$USER:$PASS" \
  --cert client.crt --key client.key --cacert ca.crt \
  "$SR_URL/subjects/mysubject/versions/latest"

# Register new schema
curl -X POST -u "$USER:$PASS" \
  --cert client.crt --key client.key --cacert ca.crt \
  -H "Content-Type: application/vnd.schemaregistry.v1+json" \
  --data '{"schema": "{\"type\":\"string\"}"}' \
  "$SR_URL/subjects/mysubject-value/versions"

