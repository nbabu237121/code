---
- name: Truncate large files (>1GB) without deleting
  hosts: all
  become: yes
  vars:
    scan_paths:
      - /var/log
      - /tmp
      - /home/app/logs
    size_threshold: 1g

  tasks:
    - name: Find large files
      ansible.builtin.find:
        paths: "{{ scan_paths }}"
        size: >={{ size_threshold }}
        recurse: yes
        file_type: file
      register: large_files

    - name: Show files to truncate
      ansible.builtin.debug:
        msg: "Will truncate {{ large_files.files | length }} files > {{ size_threshold }}"

    - name: Truncate large files to 0 bytes
      ansible.builtin.shell: |
        cat /dev/null > "{{ item.path }}"
      loop: "{{ large_files.files }}"
      args:
        removes: "{{ item.path }}"  # Skip if file gone
      register: truncate_results
